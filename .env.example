# Copy to .env and fill in. Never commit .env.

# Agent seeds: any long random phrases. They decide your agents' addresses, so keep them stable and secret.
HOMIE_SEED=
CALLER_SEED=
NEGOTIATOR_SEED=
PAPERWORK_SEED=
REPAIRS_SEED=
POLICY_SEED=
PICTURES_SEED=
RELAY_BRIDGE_SEED=

# LLM. Default: Gemini on Vertex AI using a Google service account (path only, never commit the key).
LLM_PROVIDER=vertex
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_LOCATION=us-central1
LLM_MODEL=google/gemini-2.5-flash
# Or any OpenAI-compatible API: LLM_PROVIDER=openai, LLM_BASE_URL=..., LLM_API_KEY=..., LLM_MODEL=...
LLM_BASE_URL=
LLM_API_KEY=

# Phone calls. Leave MOCK_CALLS=1 until ElevenLabs + Twilio are set up.
MOCK_CALLS=1
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# Phones that play each leasing office in the demo (E.164, e.g. +17345551234)
PHONE_MAPLE_COURT=
PHONE_ARBOR_LOFTS=
PHONE_KERRYTOWN=
PHONE_STATE_STREET=

# Hub (scoreboard + test apartment site)
HUB_URL=http://localhost:8080
AGENTVERSE_API_KEY=

# Real phone calls (Twilio dials, Gemini Live talks)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DEFAULT_AREA=downtown Atlanta, GA
MAX_CALLS=6
CALL_ANYTIME=0
