# Copy to .env and fill in. Never commit .env.

# Agent seeds: any long random phrases. They decide your agents' addresses, so keep them stable and secret.
HOMIE_SEED=
CALLER_SEED=
NEGOTIATOR_SEED=
PAPERWORK_SEED=
REPAIRS_SEED=
POLICY_SEED=
RELAY_BRIDGE_SEED=

# LLM (OpenAI-compatible). Defaults to ASI:One.
LLM_BASE_URL=https://api.asi1.ai/v1
LLM_API_KEY=
LLM_MODEL=asi1-mini

# Phone calls. Leave MOCK_CALLS=1 until ElevenLabs + Twilio are set up.
MOCK_CALLS=1
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# Phones that play each leasing office in the demo (E.164, e.g. +17345551234)
PHONE_MAPLE_COURT=
PHONE_ARBOR_LOFTS=
PHONE_KERRYTOWN=
PHONE_STATE_STREET=

# Hub (scoreboard + test apartment site)
HUB_URL=http://localhost:8080
